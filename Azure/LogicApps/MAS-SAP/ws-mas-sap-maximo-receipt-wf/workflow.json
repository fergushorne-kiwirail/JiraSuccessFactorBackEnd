{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "actions": {
      "Condition": {
        "actions": {
          "HTTP": {
            "inputs": {
              "body": "@triggerBody()",
              "headers": {
                "Content-Type": "text/xml",
                "apikey": "@{appsetting('MaximoAuthApiKey')}"
              },
              "method": "POST",
              "retryPolicy": {
                "type": "none"
              },
              "uri": "https://@{parameters('environment')}apiproxy@{parameters('region')}.krintegration.co.nz/meaweb/services/SAPEXTSYS_KRRECEIPTInterface"
            },
            "runtimeConfiguration": {
              "contentTransfer": {
                "transferMode": "Chunked"
              }
            },
            "type": "Http"
          },
          "Response": {
            "inputs": {
              "body": "@body('HTTP')",
              "statusCode": "@outputs('HTTP')?['statusCode']"
            },
            "kind": "Http",
            "runAfter": {
              "HTTP": [
                "SUCCEEDED"
              ]
            },
            "type": "Response"
          },
          "Response_1": {
            "inputs": {
              "body": "@body('HTTP')",
              "statusCode": "@outputs('HTTP')?['statusCode']"
            },
            "kind": "Http",
            "runAfter": {
              "HTTP": [
                "TIMEDOUT",
                "SKIPPED",
                "FAILED"
              ]
            },
            "type": "Response"
          }
        },
        "else": {
          "actions": {
            "Response_2": {
              "inputs": {
                "body": "Incorrect key",
                "statusCode": 401
              },
              "kind": "Http",
              "type": "Response"
            },
            "Terminate": {
              "inputs": {
                "runError": {
                  "code": "401",
                  "message": "Incorrect authorization"
                },
                "runStatus": "Failed"
              },
              "runAfter": {
                "Response_2": [
                  "SUCCEEDED"
                ]
              },
              "type": "Terminate"
            }
          }
        },
        "expression": {
          "and": [
            {
              "equals": [
                "@body('Parse_JSON')?['Auth']",
                "@parameters('SAPAuthInbound')"
              ]
            }
          ]
        },
        "runAfter": {
          "Parse_JSON": [
            "SUCCEEDED"
          ]
        },
        "type": "If"
      },
      "Parse_JSON": {
        "inputs": {
          "content": "@triggerOutputs()?['headers']",
          "schema": {
            "properties": {
              "Auth": {
                "type": "string"
              },
              "accept": {
                "type": "string"
              },
              "auditcategory": {
                "type": "string"
              },
              "cache-control": {
                "type": "string"
              },
              "content-type": {
                "type": "string"
              },
              "creationtimestamp": {
                "type": "string"
              },
              "currentsystem": {
                "type": "string"
              },
              "debug": {
                "type": "string"
              },
              "errororiginid": {
                "type": "string"
              },
              "errorstate": {
                "type": "string"
              },
              "errortype": {
                "type": "string"
              },
              "host": {
                "type": "string"
              },
              "payloadencoding": {
                "type": "string"
              },
              "payloadencrypted": {
                "type": "boolean"
              },
              "payloadsignature": {
                "type": "string"
              },
              "previousid": {
                "type": "integer"
              },
              "retrynumber": {
                "type": "string"
              },
              "transactionID": {
                "type": "string"
              },
              "userinitiatingrequest": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "x-forwarded-for": {
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "runAfter": {},
        "type": "ParseJson"
      }
    },
    "contentVersion": "1.0.0.0",
    "outputs": {},
    "triggers": {
      "manual": {
        "kind": "Http",
        "type": "Request"
      }
    }
  },
  "kind": "Stateful"
}